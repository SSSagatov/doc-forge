# PostgreSQL connection for local development.
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=postgres
DB_SSLMODE=disable

# Settings for AI
# Google Gemini API key. Availability and quotas depend on your Google project.
API_KEY=
MODEL=gemini-2.5-flash
RESPONSE_FORMAT=json_object

# Native Gemini generateContent is used; legacy FORMAT=openai is ignored.
# Optional explicit path; otherwise .env is discovered in current/parent directories.
# ENV_FILE=C:/path/to/project/.env
